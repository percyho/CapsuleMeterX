{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capsule, tooltip, and statistics windows for the local usage utility",
  "windows": ["capsule", "tooltip", "statistics"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "notification:default"
  ]
}
