{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsuleMeterX",
  "version": "0.1.0",
  "identifier": "com.capsulemeterx.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "capsule",
        "title": "CapsuleMeterX",
        "width": 120,
        "height": 32,
        "minWidth": 64,
        "maxWidth": 280,
        "minHeight": 32,
        "maxHeight": 32,
        "center": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "tooltip",
        "title": "Usage details",
        "width": 360,
        "height": 420,
        "minWidth": 220,
        "maxWidth": 360,
        "minHeight": 80,
        "center": false,
        "visible": false,
        "focus": false,
        "focusable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "statistics",
        "title": "CapsuleMeterX Statistics",
        "width": 600,
        "height": 666,
        "minWidth": 560,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
